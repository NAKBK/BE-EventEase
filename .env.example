# Required. Local PostgreSQL, or the Supabase Session pooler URL from Connect.
# Percent-encode reserved characters in the password. Add ?sslmode=require for Supabase.
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/eventease

# Required: generate at least 32 random characters; never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Demo-only endpoint. Keep false when this API holds real users or data.
ENABLE_DEMO_LOGIN=true
SEED_DEMO_DATA=true

# JSON array of exact allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

JWT_EXPIRE_MINUTES=120
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
